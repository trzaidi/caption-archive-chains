# Shared Caption Archive Supabase project (same database as design-gen-ai and caption-archive-admin).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Model calls go through the Vercel AI Gateway. Deployed functions authenticate with the
# project's OIDC token automatically; locally, `vercel env pull` writes VERCEL_OIDC_TOKEN.
# Optionally set AI_GATEWAY_API_KEY instead.
